{
  "name": "lolo",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "eas build --profile production --platform ios",
    "submit:ios": "eas submit --platform ios",
    "version:bump": "node -e \"const fs=require('fs');const config=JSON.parse(fs.readFileSync('app.json'));config.expo.ios.buildNumber=(parseInt(config.expo.ios.buildNumber||'1')+1).toString();fs.writeFileSync('app.json',JSON.stringify(config,null,2));console.log('Build number bumped to',config.expo.ios.buildNumber);\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "@supabase/supabase-js": "^2.89.0",
    "expo": "~54.0.30",
    "expo-blur": "~15.0.8",
    "expo-constants": "^18.0.12",
    "expo-font": "^14.0.10",
    "expo-linear-gradient": "^15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "dotenv": "^17.2.3",
    "typescript": "~5.9.2"
  },
  "private": true
}
